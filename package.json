{
  "name": "wtg-test",
  "displayName": "Wtg test",
  "version": "0.0.1",
  "description": "A basic Plasmo extension.",
  "author": "Plasmo Corp. <foss@plasmo.com>",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "css:build": "tailwindcss -i ./style.css -o ./style.generated.css --minify",
    "css:watch": "tailwindcss -i ./style.css -o ./style.generated.css --watch",
    "dev": "yarn css:build && concurrently --kill-others \"yarn css:watch\" \"plasmo dev\"",
    "build": "yarn css:build && plasmo build",
    "package": "yarn css:build && plasmo package"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "plasmo": "0.90.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "prettier": "3.2.4",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.3.3"
  },
  "manifest": {
    "minimum_chrome_version": "116",
    "permissions": [
      "offscreen",
      "activeTab",
      "webNavigation",
      "storage",
      "alarms"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ]
  }
}
